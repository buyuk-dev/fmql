?start: cypher

cypher: match_clause where_clause? edit_clause* return_clause? order_clause? limit_clause?

match_clause: MATCH_KW pattern

edit_clause: set_clause | remove_clause

set_clause: SET_KW set_item (COMMA set_item)*
set_item: qualified_ident set_op value_expr
set_op: EQ | PLUS_EQ

remove_clause: REMOVE_KW qualified_ident (COMMA qualified_ident)*

?value_expr: add_expr

?add_expr: add_expr PLUS unary_expr           -> ve_add
         | unary_expr

?unary_expr: NOT_KW unary_expr                -> ve_not
           | value_atom
           | func_call
           | list_lit
           | list_comp

?value_atom: value
           | qualified_ident                 -> ve_ref

func_call: IDENT "(" [value_expr (COMMA value_expr)*] ")"

list_lit: "[" [value_expr (COMMA value_expr)*] "]"

list_comp: "[" IDENT IN_KW value_expr (WHERE_KW or_expr)? (PIPE value_expr)? "]"

pattern: node (rel node)*

node: "(" IDENT (":" IDENT)? ")"

rel: "-" "[" ":" IDENT star_spec? "]" "->"

star_spec: "*" range_spec?
range_spec: INT ".." INT   -> range_both
          | INT            -> range_max
          | ".." INT       -> range_upper_only

where_clause: WHERE_KW or_expr

return_clause: RETURN_KW return_item (COMMA return_item)*

order_clause: ORDER_KW BY_KW cypher_order_key (COMMA cypher_order_key)*
cypher_order_key: order_ref direction_kw? nulls_spec?
order_ref: qualified_ident   -> order_ref_qual
direction_kw: ASC_KW | DESC_KW
nulls_spec: NULLS_KW FIRST_KW
          | NULLS_KW LAST_KW

limit_clause: LIMIT_KW INT

return_item: COUNT_KW "(" IDENT ")"          -> r_count
           | IDENT "." IDENT                 -> r_field
           | IDENT                           -> r_var
           | ESCAPED_STRING                  -> r_string
           | SIGNED_NUMBER                   -> r_number

?or_expr: and_expr (OR_KW and_expr)+         -> or_list
        | and_expr
?and_expr: not_expr (AND_KW not_expr)+       -> and_list
         | not_expr
?not_expr: NOT_KW not_expr                   -> not_op
         | atom

?atom: "(" or_expr ")"
     | predicate

predicate: qualified_ident cmp_op value                              -> p_binop
         | qualified_ident IN_KW "[" [value ("," value)*] "]"        -> p_in
         | qualified_ident NOT_KW IN_KW "[" [value ("," value)*] "]" -> p_not_in
         | qualified_ident IS_KW NOT_KW EMPTY_KW                     -> p_not_empty
         | qualified_ident IS_KW EMPTY_KW                            -> p_empty
         | qualified_ident IS_KW NOT_KW NULL_KW                      -> p_not_null
         | qualified_ident IS_KW NULL_KW                             -> p_null

qualified_ident: IDENT ("." IDENT)?

cmp_op: EQ | NEQ | GTE | LTE | GT | LT | CONTAINS_KW | MATCHES_KW

value: ESCAPED_STRING   -> v_string
     | SIGNED_NUMBER    -> v_number
     | BOOL_KW          -> v_bool
     | NULL_KW          -> v_null
     | DATE_OFFSET      -> v_date_offset

MATCH_KW.5: "MATCH"i
WHERE_KW.5: "WHERE"i
RETURN_KW.5: "RETURN"i
SET_KW.5: "SET"i
REMOVE_KW.5: "REMOVE"i
COUNT_KW.5: "count"i
ORDER_KW.5: "ORDER"i
BY_KW.5: "BY"i
ASC_KW.4: "ASC"i
DESC_KW.4: "DESC"i
NULLS_KW.4: "NULLS"i
FIRST_KW.3: "FIRST"i
LAST_KW.3: "LAST"i
LIMIT_KW.5: "LIMIT"i

AND_KW.3: "AND"i
OR_KW.3: "OR"i
NOT_KW.3: "NOT"i
IN_KW.3: "IN"i
IS_KW.3: "IS"i
EMPTY_KW.3: "EMPTY"i
NULL_KW.3: "NULL"i
CONTAINS_KW.3: "CONTAINS"i
MATCHES_KW.3: "MATCHES"i
BOOL_KW.3: "true"i | "false"i
DATE_OFFSET.3: /(today|now|yesterday|tomorrow)[+-]\d+[smhdw]/

COMMA: ","
PIPE: "|"

PLUS_EQ: "+="
PLUS: "+"
GTE: ">="
LTE: "<="
NEQ: "!=" | "<>"
EQ: "="
GT: ">"
LT: "<"

IDENT.1: /[A-Za-z_][A-Za-z0-9_]*/
INT: /\d+/

%import common.ESCAPED_STRING
%import common.SIGNED_NUMBER
%import common.WS
%ignore WS
